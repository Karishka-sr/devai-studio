<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.DevAIStudio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DevAIStudio.Launch"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.LocalModelsActivity"
            android:exported="false"
            android:label="@string/local_models_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.PremiumActivity"
            android:exported="false"
            android:label="@string/premium_title" />

        <activity
            android:name=".ui.CharactersActivity"
            android:exported="false"
            android:label="Карточки персонажей"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.McpActivity"
            android:exported="false"
            android:label="MCP-инструменты"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.PluginsActivity"
            android:exported="false"
            android:label="Плагины .devai" />

        <activity
            android:name=".ui.PluginDocsActivity"
            android:exported="false"
            android:label="Документация по плагинам" />

        <activity
            android:name=".ui.QrExportActivity"
            android:exported="false"
            android:label="QR-экспорт провайдера" />

        <activity
            android:name=".ui.ExtraToolsActivity"
            android:exported="false"
            android:label="Лаборатория инструментов"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.WallpaperActivity"
            android:exported="false"
            android:label="Обои чата" />

        <activity
            android:name="com.qwenz.qwel.MainActivity"
            android:exported="false"
            android:label="@string/vexel_app_name"
            android:icon="@mipmap/vexel_ic_launcher"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Vexel" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>