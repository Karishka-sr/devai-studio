<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/builder_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/builder_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/builder_subtitle"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Тип проекта:"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/type_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/type_android"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/builder_type_android"
                android:textColor="?attr/colorOnSurface" />

            <RadioButton
                android:id="@+id/type_web"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/builder_type_web"
                android:textColor="?attr/colorOnSurface" />

            <RadioButton
                android:id="@+id/type_python"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/builder_type_python"
                android:textColor="?attr/colorOnSurface" />

            <RadioButton
                android:id="@+id/type_kotlin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/builder_type_kotlin_cli"
                android:textColor="?attr/colorOnSurface" />

            <RadioButton
                android:id="@+id/type_ai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/builder_type_ai"
                android:textColor="?attr/colorOnSurface" />
        </RadioGroup>

        <EditText
            android:id="@+id/builder_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="@string/builder_desc_hint"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minLines="2"
            android:padding="12dp"
            android:textColor="?attr/colorOnSurface"
            android:background="@drawable/bg_input"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_zip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/builder_btn_zip"
            android:textColor="@color/white"
            app:cornerRadius="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apk"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/builder_btn_apk"
            app:cornerRadius="28dp" />

        <TextView
            android:id="@+id/builder_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>